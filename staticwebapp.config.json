{
  "platform": {
    "apiRuntime": "node:20"
  },
  "mimeTypes": {
    ".mp4": "video/mp4"
  },
  "routes": [
    {
      "route": "/assets/video/*",
      "headers": {
        "cache-control": "public, max-age=86400"
      }
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  }
}
